#!/bin/bash
# ==============================================================================
# PSU Materials Portal - LMS One-Click Sync Launcher
# ดับเบิ้ลคลิกเพื่ออัปเดตงานและควิซล่าสุดจาก PSU LMS เข้าสู่หน้าเว็บโดยอัตโนมัติ
# ==============================================================================

clear
echo "=================================================================="
echo "    🚀 PSU MATERIALS PORTAL - LMS SYNC ENGINE                    "
echo "=================================================================="
echo ""
echo "กำลังเชื่อมต่อกับ Safari เพื่อดึงข้อมูลงานและควิซล่าสุดจาก LMS..."
echo ""

PORTAL_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
/usr/bin/python3 "$PORTAL_DIR/scripts/sync_lms_engine.py"

echo "=================================================================="
echo "✨ ซิงค์เสร็จสิ้น! สามารถปิดหน้าต่างนี้ได้เลยครับ"
echo "=================================================================="
sleep 2
exit 0
