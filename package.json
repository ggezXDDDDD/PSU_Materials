{
  "name": "psu-materials",
  "version": "1.0.0",
  "description": "PSU Materials Science Academic Portal & LMS Deadline Radar",
  "scripts": {
    "dev": "python3 dev.py",
    "format": "prettier --write \"**/*.{html,css,js,json}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json}\"",
    "check:links": "python3 scripts/verify_links.py",
    "android:prepare": "python3 scripts/prepare_capacitor_web.py",
    "android:sync": "bun run android:prepare && cap sync android",
    "test:android:web": "python3 tests/test_capacitor_web.py"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
